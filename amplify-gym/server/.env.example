# SQLite en desarrollo. Para producción (Postgres) cambia el provider en
# prisma/schema.prisma y apunta DATABASE_URL a tu instancia.
DATABASE_URL="file:./dev.db"
PORT=4000

# Opcional: si la defines, toda la API exige esta clave (header x-api-key o ?key=).
# Recomendado al desplegar en internet (Render). Genera una larga y aleatoria.
# API_KEY="cambia-esto-por-una-clave-larga"
